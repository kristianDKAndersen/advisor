{
  "path_denylist": [
    "**/.env*",
    "**/secrets/**",
    "**/*.pem",
    "**/id_rsa*",
    "infra/**",
    "deploy/**",
    ".github/workflows/**",
    "claude.md",
    "CLAUDE.md",
    "spawns/**",
    ".claude/**",
    "gates/**",
    ".advisor-preserved/**"
  ],
  "action_allowlist": {
    "worktree_write": true,
    "git_commit": true,
    "git_push": false,
    "network_egress": false,
    "delete_outside_worktree": false,
    "exec_deploy_scripts": false
  },
  "worktree_root": "REPLACE_ME_worktree_root_per_run",
  "on_violation": "halt-escalate"
}
