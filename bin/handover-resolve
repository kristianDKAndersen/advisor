#!/usr/bin/env bun
// Marks a handover resolved: header rewritten in place, or a legacy `FINAL OUTCOME: <text>` line appended.
// Usage: handover-resolve <file> --outcome "<status text>" [-h|--help]
// Exit: 0 resolved, 1 IO error, 2 usage / not a handover / invalid or unreadable, 3 refused symlink (file or its directory), 4 already resolved.
// Run from the successor session once the work is done, not at handover-write time.

import { resolveHandover } from '../lib/handover.js';

const USAGE = 'Usage: handover-resolve <file> --outcome "<status text>" [-h|--help]';
const args = process.argv.slice(2);

if (args.includes('-h') || args.includes('--help')) {
  console.log(USAGE);
  process.exit(0);
}

let file = null;
let outcome = null;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--outcome') {
    outcome = args[++i] ?? null;
  } else if (a.startsWith('-') || file !== null) {
    console.error(`handover-resolve: unexpected argument: ${a}\n${USAGE}`);
    process.exit(2);
  } else {
    file = a;
  }
}

const res = resolveHandover(file, outcome);
if (res.code === 0) console.log(res.message);
else console.error(`handover-resolve: ${res.message}`);
process.exit(res.code);
