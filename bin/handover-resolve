#!/usr/bin/env bun
// bin/handover-resolve — mechanically resolve a context-handover file written
// by bin/handover-write (or by hand, legacy format). A file with a front-matter
// header gets `status: resolved`, `resolved` and `outcome` rewritten in place; a
// legacy headerless file gets a `FINAL OUTCOME: <text>` line appended. All the
// logic lives in resolveHandover() in lib/handover.js.
//
// Run this from the SUCCESSOR session that actually finishes the handed-over
// work (see the "Recovery" section of the pre-compact SKILL.md) — not at
// handover-write time, since the work isn't done yet when the handover is written.
//
// Usage:
//   handover-resolve <file> --outcome "<status text>" [-h|--help]
//
// Exit codes: 0 resolved, 1 IO error, 2 usage / not a handover / invalid,
// 3 refused symlink, 4 already resolved.

import { resolveHandover } from '../lib/handover.js';

const USAGE = 'Usage: handover-resolve <file> --outcome "<status text>" [-h|--help]';
const args = process.argv.slice(2);

if (args.includes('-h') || args.includes('--help')) {
  console.log(USAGE);
  process.exit(0);
}

let file = null;
let outcome = null;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--outcome') {
    outcome = args[++i] ?? null;
  } else if (a.startsWith('-') || file !== null) {
    console.error(`handover-resolve: unexpected argument: ${a}\n${USAGE}`);
    process.exit(2);
  } else {
    file = a;
  }
}

const res = resolveHandover(file, outcome);
if (res.code === 0) console.log(res.message);
else console.error(`handover-resolve: ${res.message}`);
process.exit(res.code);
