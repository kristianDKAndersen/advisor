#!/usr/bin/env bun
// bin/advisor-check-doctrine — spawn-prompt doctrine drift checker.
//
// Usage:
//   advisor-check-doctrine [<root>] [--root <path>] [--json] [--strict]
//
// Walks spawns/*/CLAUDE.md under <root> (default cwd) and asserts the
// invariants the root advisor doctrine already declares:
//   (a) no explicit contradiction of the self-terminate-after-result contract  [ERROR]
//   (b) no Task()/spawn instruction without an accompanying no-further-
//       recursion guard statement (workers cannot summon workers)             [ERROR]
//   (c) the file declares some result/deliverable-reporting contract          [WARNING]
//   (d) every `--agent <name>` reference resolves to a real spawns/<name>
//       directory                                                             [ERROR]
//
// Two-tier severity, matching bin/advisor-check-freshness's house pattern:
// contradictions (a, b, d) are hard failures (exit 1); a silent omission of
// the result contract (c) is a warning (exit 0) since that contract is
// centrally delivered by skills/worker-protocol/SKILL.md, which every worker
// runs at session start (lib/summon.js) — silence there is not contradiction.
// --strict promotes warnings to errors for a stricter gate.
//
// Does NOT check last_edited freshness — that is bin/advisor-check-freshness's
// job; duplicating it here would just be two checkers disagreeing over time.

const { readdirSync, statSync, readFileSync, existsSync } = require('node:fs');
const { join, relative } = require('node:path');

let root = process.cwd();
let json = false;
let strict = false;
let rootFromFlag = false;

const args = process.argv.slice(2);
while (args.length > 0) {
  const arg = args.shift();
  switch (arg) {
    case '--root':
      root = args.shift();
      rootFromFlag = true;
      break;
    case '--json':
      json = true;
      break;
    case '--strict':
      strict = true;
      break;
    case '-h':
    case '--help':
      console.log(`Usage: advisor-check-doctrine [<root>] [--root <path>] [--json] [--strict]

Walks spawns/*/CLAUDE.md under <root> (default cwd) and asserts the
invariants the root advisor doctrine already declares:
  (a) self-terminate-after-result   — no explicit contradiction        [ERROR]
  (b) no-recursive-spawning         — no Task()/spawn instruction lacking
                                       an accompanying recursion guard  [ERROR]
  (c) result-contract               — file declares how it reports/delivers
                                       (omission only, not contradiction) [WARNING]
  (d) agent-name-resolution         — every --agent <name> reference
                                       resolves to spawns/<name>/CLAUDE.md [ERROR]

Flags:
  --root <path>   Root directory to scan (default: cwd)
  --json          Emit machine-readable JSON instead of text
  --strict        Promote warnings to errors (fail the gate on any finding)

Exit codes: 0 = clean or warnings only (without --strict), 1 = one or more
errors found (or one or more warnings found, with --strict).
`);
      process.exit(0);
      break;
    default:
      if (!rootFromFlag && !arg.startsWith('--')) {
        root = arg;
      } else {
        console.error(`Unknown flag: ${arg}`);
        process.exit(1);
      }
  }
}

// --- invariant patterns -----------------------------------------------

const SELF_TERM_CONTRADICTION =
  /stay alive\b[^\n]{0,60}(iteration|result)|do\s+\*{0,2}not\*{0,2}\s+exit\s+after[^\n]{0,20}`?result`?|remain\s+(running|alive)\b[^\n]{0,60}result|keep[^\n]{0,20}(session|tab)[^\n]{0,20}open[^\n]{0,40}result/i;

const SPAWN_ATTEMPT = /Task\(|Use the Task tool to (spawn|invoke)/i;

const RECURSION_GUARD =
  /recursion is structurally impossible|do not spawn further|never spawn further|no further subagents|cannot spawn|already a worker|workers cannot summon workers|you do not orchestrate,? delegate,? or spawn/i;

const RESULT_CONTRACT =
  /send[^\n]{0,20}`?result`?|result envelope|outbox|channel\.js|report(?:s|ed|ing)?\s+(?:its|the)\s+(?:absolute\s+)?path|ReportFindings/i;

const AGENT_REF = /--agent\s+([a-zA-Z0-9_-]+)/g;

// --- walk spawns/*/CLAUDE.md -------------------------------------------

function findSpawnNames(root) {
  const base = join(root, 'spawns');
  let entries;
  try {
    entries = readdirSync(base);
  } catch {
    return [];
  }
  const names = [];
  for (const entry of entries) {
    let st;
    try {
      st = statSync(join(base, entry));
    } catch {
      continue;
    }
    if (st.isDirectory()) names.push(entry);
  }
  return names;
}

function findTargets(root, names) {
  const targets = [];
  for (const name of names) {
    const filePath = join(root, 'spawns', name, 'CLAUDE.md');
    try {
      statSync(filePath);
    } catch {
      continue;
    }
    targets.push({ name, filePath });
  }
  return targets;
}

const spawnNames = findSpawnNames(root);
const spawnNameSet = new Set(spawnNames);
const targets = findTargets(root, spawnNames);

const violations = [];

for (const { name, filePath } of targets) {
  const relPath = relative(root, filePath);
  const content = readFileSync(filePath, 'utf8');

  if (SELF_TERM_CONTRADICTION.test(content)) {
    violations.push({
      file: relPath,
      invariant: 'self-terminate-after-result',
      severity: 'error',
      detail: 'file contains language contradicting the self-terminate-after-result contract (e.g. "stay alive", "do not exit after result")',
    });
  }

  if (SPAWN_ATTEMPT.test(content) && !RECURSION_GUARD.test(content)) {
    violations.push({
      file: relPath,
      invariant: 'no-recursive-spawning',
      severity: 'error',
      detail: 'file instructs a Task()/spawn call with no accompanying recursion-guard statement (workers cannot summon workers)',
    });
  }

  if (!RESULT_CONTRACT.test(content)) {
    violations.push({
      file: relPath,
      invariant: 'result-contract',
      severity: 'warning',
      detail: 'file never declares how it reports or delivers its result (no result/outbox/channel.js/report-path language found) — this may be an omission, not a contradiction; the contract is centrally delivered by skills/worker-protocol/SKILL.md',
    });
  }

  let m;
  AGENT_REF.lastIndex = 0;
  const seen = new Set();
  while ((m = AGENT_REF.exec(content)) !== null) {
    const agentName = m[1];
    if (seen.has(agentName)) continue;
    seen.add(agentName);
    if (!spawnNameSet.has(agentName)) {
      violations.push({
        file: relPath,
        invariant: 'agent-name-resolution',
        severity: 'error',
        detail: `references --agent ${agentName} which has no spawns/${agentName}/CLAUDE.md directory`,
      });
    }
  }
}

const errors = violations.filter((v) => v.severity === 'error');
const warnings = violations.filter((v) => v.severity === 'warning');
const failingCount = strict ? violations.length : errors.length;

if (json) {
  console.log(JSON.stringify({ checked: targets.length, violations, errors: errors.length, warnings: warnings.length, strict }));
} else if (violations.length > 0) {
  console.error(`advisor-check-doctrine: ${errors.length} error(s), ${warnings.length} warning(s) across ${targets.length} file(s) checked:`);
  for (const v of errors) {
    console.error(`  - [ERROR] [${v.invariant}] ${v.file}: ${v.detail}`);
  }
  for (const v of warnings) {
    console.error(`  - [WARNING] [${v.invariant}] ${v.file}: ${v.detail}`);
  }
  if (strict && warnings.length > 0) {
    console.error(`--strict: promoting ${warnings.length} warning(s) to error(s).`);
  }
} else {
  console.log(`advisor-check-doctrine: ${targets.length} file(s) checked, 0 violations.`);
}

process.exit(failingCount > 0 ? 1 : 0);
