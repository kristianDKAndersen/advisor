#!/usr/bin/env bun
// bin/advisor-check-brief-paths — asserts every repo-relative path cited in a
// brief is actually visible to a worker worktree.
//
// Usage:
//   advisor-check-brief-paths --file <path> [--root <path>] [--warn] [--json]
//   cat brief.txt | advisor-check-brief-paths [--root <path>] [--warn] [--json]
//
// A cited path is visible to a worker worktree only if BOTH hold: it is
// tracked by git (`git ls-files --error-unmatch` succeeds) AND it is not
// gitignored (`git check-ignore -q` does not match). An untracked-but-
// present-on-disk file is INVISIBLE — that is the entire point, since it
// exists in the advisor cwd but a worker worktree (a git checkout) will not
// have it. Exits 1 listing every invisible cited path; --warn downgrades to
// exit 0 while still printing the report.
//
// Two further checks catch briefs that describe repo state a worker
// worktree will not see even though the path itself is git-visible:
//
//   Check A (stale vs HEAD): a cited path that IS tracked and not ignored
//   but differs from HEAD (`git diff HEAD -- <path>` produces output —
//   covers both unstaged and staged-but-uncommitted changes) is reported at
//   the same severity as invisible, since a worker worktree is created from
//   committed state and will read HEAD, not the working tree.
//
//   Check B (cited commits): hex tokens (7-40 lowercase hex chars) that
//   appear near a commit-context word (commit/committed/sha/revision) are
//   treated as commit claims. A token that does not resolve to a commit
//   object is an ERROR; a token that resolves but is not an ancestor of
//   HEAD is a WARNING (the object exists but its content is absent from the
//   worker worktree's history). Conservative by design — see the token
//   regex and proximity window below.

const { readFileSync, existsSync, realpathSync, statSync } = require('node:fs');
const { relative, join } = require('node:path');
const { execFileSync } = require('node:child_process');

let root = process.cwd();
let file = null;
let warn = false;
let json = false;

const args = process.argv.slice(2);
while (args.length > 0) {
  const arg = args.shift();
  switch (arg) {
    case '--file':
      file = args.shift();
      break;
    case '--root':
      root = args.shift();
      break;
    case '--warn':
      warn = true;
      break;
    case '--json':
      json = true;
      break;
    case '-h':
    case '--help':
      console.log(`Usage: advisor-check-brief-paths --file <path> [--root <path>] [--warn] [--json]
       cat brief.txt | advisor-check-brief-paths [--root <path>] [--warn] [--json]

Extracts repo-relative filesystem paths cited in brief text and asserts each
one is git-visible to a worker worktree: tracked AND not gitignored, and not
stale vs HEAD. Also extracts conservatively-identified cited commits and
asserts each resolves and is an ancestor of HEAD.

Flags:
  --file <path>   Read brief text from this file (default: stdin)
  --root <path>   Repo root to check paths against (default: cwd)
  --warn          Print the report but exit 0 instead of 1 on invisible paths
  --json          Emit machine-readable JSON instead of text
`);
      process.exit(0);
      break;
    default:
      console.error(`Unknown flag: ${arg}`);
      process.exit(1);
  }
}

const KNOWN_EXT = /\.(md|mdx|js|mjs|cjs|ts|tsx|jsx|json|jsonl|yaml|yml|py|sh|bash|txt|html|htm|css|scss|rb|go|rs|java|c|cpp|h|hpp|toml|ini|cfg|lock|xml|sql|proto|graphql|vue|svelte)$/i;

// Brief text is XML-ish (<objective>...</objective>), often with no whitespace
// between a closing tag and the next word/path — strip tags before splitting
// so neither side of the boundary is swallowed into a bogus candidate token.
const TAG_RE = /<\/?[A-Za-z][A-Za-z0-9_:-]*\/?>/g;
const LINE_SUFFIX_RE = /:\d+(-\d+)?$/;

// A dirCache memoizes "does <root>/<segment> exist as a directory" lookups
// across candidates in one run.
function makeDirChecker(root) {
  const cache = new Map();
  return (segment) => {
    if (cache.has(segment)) return cache.get(segment);
    let isDir = false;
    if (root) {
      try {
        isDir = statSync(join(root, segment)).isDirectory();
      } catch {
        isDir = false;
      }
    }
    cache.set(segment, isDir);
    return isDir;
  };
}

// A line that names an absolute path outside the repo (or a $VAR/~ path)
// puts any bare filename mentioned later on that same line in its context —
// "evidence tables audit-A.md, audit-B.md ... in the same folder" cites
// files colocated with the external path just named, not repo paths.
const EXTERNAL_MARKER_RE = /(\$[A-Z_][A-Z0-9_]*\/|~\/|\/(?:Users|home)\/)/;

function extractPaths(text, root) {
  const stripped = text.replace(TAG_RE, ' ');
  const candidates = new Set();
  const skippedNotRepoRelative = new Set();
  const isKnownDir = makeDirChecker(root);
  for (const line of stripped.split('\n')) {
    const lineHasExternalMarker = EXTERNAL_MARKER_RE.test(line);
    for (const raw of line.split(/\s+/)) {
      let tok = raw.replace(/^[`'"([{<]+/, '').replace(/[`'")\]}>,.;:!?]+$/, '');
      if (!tok) continue;
      if (/^https?:\/\//i.test(tok) || tok.includes('://')) continue;
      if (tok.startsWith('-')) continue;
      if (/^\d+\/\d+$/.test(tok)) continue;
      if (tok.includes('*') || tok.includes('?')) continue; // glob pattern quoted in prose, not a literal path
      tok = tok.replace(LINE_SUFFIX_RE, '');
      if (!tok) continue;
      // $VAR/... and ~/... reference the caller's environment, not a
      // repo-relative path — never checkable against the worktree.
      if (tok.startsWith('$') || tok.startsWith('~/') || tok === '~') {
        skippedNotRepoRelative.add(tok);
        continue;
      }
      const hasSlash = tok.includes('/');
      const hasKnownExt = KNOWN_EXT.test(tok);
      if (!hasSlash && !hasKnownExt) continue;
      if (hasSlash && !hasKnownExt) {
        // Slash-joined bare words with no extension (Read/Grep/Glob,
        // send/recv/tail) are prose enumerations, not paths, unless the
        // first segment is an actual directory in the repo.
        const firstSegment = tok.split('/')[0];
        if (!isKnownDir(firstSegment)) continue;
      }
      if (/^\.\w{1,6}$/.test(tok)) continue; // stray extension fragment (".md"), not a filename
      if (lineHasExternalMarker) {
        // On a line naming an external ($VAR/~/absolute) path, a bare
        // filename or a slash-path with no known repo directory prefix is
        // colocated with that external path, not a repo-relative citation.
        if (!hasSlash || !isKnownDir(tok.split('/')[0])) {
          skippedNotRepoRelative.add(tok);
          continue;
        }
      }
      candidates.add(tok);
    }
  }
  return { candidates: [...candidates], skippedNotRepoRelative: [...skippedNotRepoRelative] };
}

function toRepoRelative(tok, resolvedRoot) {
  if (tok.startsWith('/')) {
    if (tok === resolvedRoot || tok.startsWith(resolvedRoot + '/')) {
      return relative(resolvedRoot, tok);
    }
    return null; // outside the repo (e.g. a worker output dir), not our concern
  }
  if (tok.startsWith('../')) return null;
  return tok;
}

function isTracked(root, relPath) {
  try {
    execFileSync('git', ['ls-files', '--error-unmatch', '--', relPath], {
      cwd: root,
      stdio: ['ignore', 'ignore', 'ignore'],
    });
    return true;
  } catch {
    return false;
  }
}

function isIgnored(root, relPath) {
  try {
    execFileSync('git', ['check-ignore', '-q', '--', relPath], {
      cwd: root,
      stdio: ['ignore', 'ignore', 'ignore'],
    });
    return true; // exit 0 = matched an ignore rule
  } catch (e) {
    return false; // exit 1 = not ignored (exit >1 treated the same: not confirmed ignored)
  }
}

function coreIgnoreCase(root) {
  try {
    const out = execFileSync('git', ['config', '--get', 'core.ignorecase'], {
      cwd: root,
      stdio: ['ignore', 'pipe', 'ignore'],
    }).toString().trim();
    return out === 'true';
  } catch {
    return false;
  }
}

// git ls-files is case-SENSITIVE even when core.ignorecase=true (that setting only
// governs git's own working-tree comparisons, not this plumbing command). On such a
// checkout a cited path that differs only in case from a tracked path IS visible to
// the worker worktree, so we must resolve it ourselves via a case-folded scan.
function findTrackedCaseInsensitive(root, relPath) {
  try {
    const out = execFileSync('git', ['ls-files'], {
      cwd: root,
      stdio: ['ignore', 'pipe', 'ignore'],
    }).toString();
    const target = relPath.toLowerCase();
    for (const line of out.split('\n')) {
      if (line && line.toLowerCase() === target) return line;
    }
    return null;
  } catch {
    return null;
  }
}

let lsFilesCache = null;
function allTrackedFiles(root) {
  if (lsFilesCache) return lsFilesCache;
  try {
    lsFilesCache = execFileSync('git', ['ls-files'], {
      cwd: root,
      stdio: ['ignore', 'pipe', 'ignore'],
    }).toString().split('\n').filter(Boolean);
  } catch {
    lsFilesCache = [];
  }
  return lsFilesCache;
}

// A bare filename cited without a directory (e.g. prose shorthand
// "channel.js" for lib/channel.js) resolves to a tracked path only when
// exactly one tracked file has that basename — an ambiguous or absent
// basename is left unresolved and checked (and likely reported) as-is.
function resolveBareBasename(root, tok) {
  if (tok.includes('/')) return null;
  const matches = allTrackedFiles(root).filter((f) => f.slice(f.lastIndexOf('/') + 1) === tok);
  return matches.length === 1 ? matches[0] : null;
}

function isStale(root, relPath) {
  try {
    const out = execFileSync('git', ['diff', 'HEAD', '--', relPath], {
      cwd: root,
      stdio: ['ignore', 'pipe', 'ignore'],
    });
    return out.length > 0; // covers both unstaged and staged-but-uncommitted changes
  } catch {
    return false;
  }
}

// Check B: conservative cited-commit extraction. A hex-looking token is only
// treated as a commit claim when a commit-context word appears within a
// small character window around it — this is the precision guard the spec
// demands (colour codes, checksums, fixture ids must NOT be flagged).
const HEX_TOKEN = /\b[0-9a-f]{7,40}\b/g;
const COMMIT_CONTEXT = /\b(commit(?:ted)?|sha|revision)\b/i;
const COMMIT_PROXIMITY = 60;

function extractCommitClaims(text) {
  const claims = [];
  const seen = new Set();
  let m;
  HEX_TOKEN.lastIndex = 0;
  while ((m = HEX_TOKEN.exec(text)) !== null) {
    const tok = m[0];
    if (seen.has(tok)) continue;
    const windowStart = Math.max(0, m.index - COMMIT_PROXIMITY);
    const windowEnd = Math.min(text.length, m.index + tok.length + COMMIT_PROXIMITY);
    const window = text.slice(windowStart, windowEnd);
    if (COMMIT_CONTEXT.test(window)) {
      seen.add(tok);
      claims.push(tok);
    }
  }
  return claims;
}

function resolvesToCommit(root, token) {
  try {
    execFileSync('git', ['rev-parse', '--verify', '--quiet', `${token}^{commit}`], {
      cwd: root,
      stdio: ['ignore', 'ignore', 'ignore'],
    });
    return true;
  } catch {
    return false;
  }
}

function isAncestorOfHead(root, token) {
  try {
    execFileSync('git', ['merge-base', '--is-ancestor', token, 'HEAD'], {
      cwd: root,
      stdio: ['ignore', 'ignore', 'ignore'],
    });
    return true;
  } catch {
    return false;
  }
}

let briefText;
if (file) {
  briefText = readFileSync(file, 'utf8');
} else {
  try {
    briefText = readFileSync(0, 'utf8');
  } catch {
    briefText = '';
  }
}

const resolvedRoot = realpathSync(root);
const { candidates: rawCandidates, skippedNotRepoRelative } = extractPaths(briefText, resolvedRoot);
const ignoreCase = coreIgnoreCase(resolvedRoot);

const seen = new Set();
const checked = [];
const invisible = [];
const stale = [];
const caseMismatches = [];
const bareNotChecked = [];

for (const tok of rawCandidates) {
  const relPath = toRepoRelative(tok, resolvedRoot);
  if (relPath === null || relPath === '') continue;
  if (seen.has(relPath)) continue;
  seen.add(relPath);

  let tracked = isTracked(resolvedRoot, relPath);
  let resolvedPath = relPath;
  let trackedAs = null;
  if (!tracked && !relPath.includes('/')) {
    // A bare basename that matches a DIFFERENT tracked file must never satisfy
    // the invisibility check for the literal cited token — that would silence
    // the warning for an untracked new file with the same basename elsewhere.
    // Report it separately instead of resolving tracked/resolvedPath.
    const basenameMatch = resolveBareBasename(resolvedRoot, relPath);
    if (basenameMatch) {
      bareNotChecked.push({ path: relPath, resolvedTo: basenameMatch });
    }
  }
  if (!tracked && ignoreCase) {
    const actualTracked = findTrackedCaseInsensitive(resolvedRoot, relPath);
    if (actualTracked) {
      tracked = true;
      resolvedPath = actualTracked;
      trackedAs = actualTracked;
    }
  }
  const ignored = isIgnored(resolvedRoot, resolvedPath);
  const visible = tracked && !ignored;
  checked.push(relPath);

  if (!visible) {
    let reason;
    if (tracked && ignored) {
      reason = 'tracked but gitignored';
    } else if (ignored) {
      reason = 'gitignored';
    } else if (existsSync(join(resolvedRoot, relPath))) {
      reason = 'untracked (exists on disk but not committed)';
    } else {
      reason = 'nonexistent (no such path)';
    }
    invisible.push({ path: relPath, reason });
  } else {
    if (trackedAs) {
      caseMismatches.push({
        path: relPath,
        trackedAs,
        reason: `cited '${relPath}' but tracked as '${trackedAs}' — visible to the worker worktree under that casing`,
      });
    }
    if (isStale(resolvedRoot, resolvedPath)) {
      stale.push({
        path: relPath,
        reason: 'differs from HEAD (uncommitted changes) — a worker worktree is created from committed state and will see the HEAD version, not this one',
      });
    }
  }
}

const commits = [];
for (const token of extractCommitClaims(briefText)) {
  if (!resolvesToCommit(resolvedRoot, token)) {
    commits.push({ token, status: 'error', detail: 'does not resolve to a commit object' });
  } else if (!isAncestorOfHead(resolvedRoot, token)) {
    commits.push({
      token,
      status: 'warning',
      detail: 'resolves to a commit but is not an ancestor of HEAD — absent from the worker worktree history',
    });
  }
}
const commitErrors = commits.filter((c) => c.status === 'error');
const commitWarnings = commits.filter((c) => c.status === 'warning');

if (json) {
  console.log(JSON.stringify({ checked: checked.length, invisible, stale, caseMismatches, bareNotChecked, commits, skippedNotRepoRelative }));
} else {
  let printedAny = false;
  if (skippedNotRepoRelative.length > 0) {
    console.error(`advisor-check-brief-paths: ${skippedNotRepoRelative.length} cited token(s) not checked (outside repo, e.g. $VAR/... or ~/...):`);
    for (const s of skippedNotRepoRelative) console.error(`  - ${s}`);
  }
  if (invisible.length > 0) {
    console.error(`advisor-check-brief-paths: ${invisible.length} cited path(s) invisible to a worker worktree:`);
    for (const inv of invisible) console.error(`  - ${inv.path} (${inv.reason})`);
    printedAny = true;
  }
  if (bareNotChecked.length > 0) {
    console.error(`advisor-check-brief-paths: ${bareNotChecked.length} bare filename(s) not checked (ambiguous with a different tracked file):`);
    for (const b of bareNotChecked) console.error(`  - ${b.path} (matches tracked '${b.resolvedTo}' but cited without a directory — not verified as the same file)`);
  }
  if (caseMismatches.length > 0) {
    console.error(`advisor-check-brief-paths: ${caseMismatches.length} cited path(s) visible only under a different casing:`);
    for (const c of caseMismatches) console.error(`  - ${c.path} (${c.reason})`);
    printedAny = true;
  }
  if (stale.length > 0) {
    console.error(`advisor-check-brief-paths: ${stale.length} cited path(s) stale vs HEAD:`);
    for (const s of stale) console.error(`  - ${s.path} (${s.reason})`);
    printedAny = true;
  }
  if (commitErrors.length > 0) {
    console.error(`advisor-check-brief-paths: ${commitErrors.length} cited commit(s) do not resolve:`);
    for (const c of commitErrors) console.error(`  - ${c.token} (${c.detail})`);
    printedAny = true;
  }
  if (commitWarnings.length > 0) {
    console.error(`advisor-check-brief-paths: ${commitWarnings.length} cited commit(s) not an ancestor of HEAD:`);
    for (const c of commitWarnings) console.error(`  - ${c.token} (${c.detail})`);
    printedAny = true;
  }
  if (!printedAny) {
    console.log(`advisor-check-brief-paths: ${checked.length} cited path(s) checked, all visible.`);
  }
}

const hasErrors = invisible.length > 0 || stale.length > 0 || commitErrors.length > 0;
process.exit(!warn && hasErrors ? 1 : 0);
