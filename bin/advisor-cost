#!/usr/bin/env node
// advisor-cost — per-session token usage and estimated cost.
//
// Usage:
//   advisor-cost [<sid>] [--sid <uuid>] [--last N] [--by-agent] [--help]
//
// Reads ~/.advisor/state/token-usage.jsonl (cumulative snapshots — takes last per sid).
// Lines are Claude Code session UUIDs. A positional or --sid run-sid (e.g.
// "1783078917-04d530") is resolved to its claude_uuid via session-map.jsonl.
// --by-agent reads optional ~/.advisor/state/session-map.jsonl {run_sid,claude_uuid,agent}.
// Override state path with ADVISOR_STATE_DIR for testing.
//
// Pricing: cache_read and cache_creation are priced at published discounted rates,
// not excluded — they are real costs. Source: platform.claude.com/docs pricing page, fetched 2026-10-05.

const fs = require('fs');
const path = require('path');
const os = require('os');
const telemetryBackfill = require('../lib/telemetry-backfill');

// Price per million tokens, USD, by exact model id (longest-prefix match so
// date-suffixed ids like claude-haiku-4-5-20251001 resolve to claude-haiku-4-5).
// claude-haiku-5-5 has two rate cards chosen per request by prompt size: the plain row is
// prompt <= 100K, the ':long' row (by_model key written by telemetry) is prompt > 100K.
// cache_creation = 5m cache write rate (kept for back-compat with the old field name).
// cache_write_1h = 1h TTL cache write rate (distinct from the 5m rate; do not conflate).
const PRICE_TABLE = {
  'claude-opus-5-5':   { input: 4,  output: 20, cache_read: 0.20, cache_creation: 5,    cache_write_1h: 8  },
  'claude-opus-5':     { input: 5,  output: 25, cache_read: 0.50, cache_creation: 6.25, cache_write_1h: 10 },
  'claude-opus-4-8':   { input: 5,  output: 25, cache_read: 0.50, cache_creation: 6.25, cache_write_1h: 10 },
  'claude-opus-4-7':   { input: 5,  output: 25, cache_read: 0.50, cache_creation: 6.25, cache_write_1h: 10 },
  'claude-opus-4-6':   { input: 5,  output: 25, cache_read: 0.50, cache_creation: 6.25, cache_write_1h: 10 },
  'claude-sonnet-5-5': { input: 2,  output: 10, cache_read: 0.20, cache_creation: 2.5,  cache_write_1h: 4  },
  'claude-sonnet-5':   { input: 2,  output: 10, cache_read: 0.20, cache_creation: 2.5,  cache_write_1h: 4  },
  'claude-sonnet-4-6': { input: 3,  output: 15, cache_read: 0.30, cache_creation: 3.75, cache_write_1h: 6  },
  'claude-haiku-4-5':  { input: 1,  output: 5,  cache_read: 0.10, cache_creation: 1.25, cache_write_1h: 2  },
  'claude-haiku-5-5':  { input: 0.10, output: 0.50, cache_read: 0.01, cache_creation: 0.125, cache_write_1h: 0.20 },
  'claude-haiku-5-5:long': { input: 0.50, output: 2.50, cache_read: 0.05, cache_creation: 0.625, cache_write_1h: 1.00 },
  'claude-fable-5-1':  { input: 10, output: 50, cache_read: 0.25, cache_creation: 12.5, cache_write_1h: 20 },
  'claude-fable-5':    { input: 10, output: 50, cache_read: 1,    cache_creation: 12.5, cache_write_1h: 20 },
};
// Default/unknown-model fallback: priced at the sonnet-5-5 row, flagged (never silent).
const DEFAULT_PRICE = PRICE_TABLE['claude-sonnet-5-5'];

// Longest key first so e.g. "claude-opus-5-5" is tried before "claude-opus-5".
const PRICE_KEYS = Object.keys(PRICE_TABLE).sort((a, b) => b.length - a.length);

// Rows whose per-request prompt size is invisible must price these at the <=100K card and be flagged.
const TIER_SPLIT_KEYS = new Set(['claude-haiku-5-5']);
const HAIKU55_FLAG = 'haiku55-tier-unknown';

function priceForModel(modelId) {
  if (modelId) {
    for (const key of PRICE_KEYS) {
      if (modelId === key || modelId.startsWith(key + '-')) {
        return { ...PRICE_TABLE[key], known: true, tierUnknown: TIER_SPLIT_KEYS.has(key) };
      }
    }
  }
  return { ...DEFAULT_PRICE, known: false };
}

function stateDir() {
  return process.env.ADVISOR_STATE_DIR ||
    path.join(os.homedir(), '.advisor', 'state');
}

function readTokenUsage(stDir) {
  const p = path.join(stDir, 'token-usage.jsonl');
  if (!fs.existsSync(p)) return [];
  const lines = fs.readFileSync(p, 'utf8').split('\n');
  const out = [];
  for (const line of lines) {
    if (!line.trim()) continue;
    try { out.push(JSON.parse(line)); } catch (_) {}
  }
  return out;
}

// Take last snapshot per sid; result preserves last-seen order (most-recently-active last).
function lastPerSid(entries) {
  const map = new Map();
  for (const e of entries) {
    if (!e.sid) continue;
    if (map.has(e.sid)) map.delete(e.sid); // re-insert at end to track last-seen position
    map.set(e.sid, e);
  }
  return [...map.values()];
}

// Prices one by_model entry's five fields against its model's rates.
function costForModelUsage(modelId, u) {
  const r = priceForModel(modelId);
  const cost =
    ((u.input_tokens || 0) / 1_000_000) * r.input +
    ((u.output_tokens || 0) / 1_000_000) * r.output +
    ((u.cache_read_input_tokens || 0) / 1_000_000) * r.cache_read +
    ((u.cache_creation_5m_input_tokens || 0) / 1_000_000) * r.cache_creation +
    ((u.cache_creation_1h_input_tokens || 0) / 1_000_000) * r.cache_write_1h;
  return { cost, known: r.known };
}

// v2 rows (counting:"dedupe-v2") carry by_model and are priced per-model with
// separate 5m/1h cache-write rates. Legacy rows (no "counting" field) have no
// model, are over-counted ~2.14x median, and are priced at today's default
// (sonnet-4-6 @ 5m write rate) so historical dollar figures don't move — marked
// "legacy" rather than silently re-scaled.
function normalizeEntry(e) {
  // dedupe-v3 rows additionally fold advisor-tool iterations into by_model
  // (see sumUsageFromLines/sumTranscriptUsage); same by_model shape as v2, so
  // pricing is identical — just accept both tags.
  const isV2 = e.counting === 'dedupe-v2' || e.counting === 'dedupe-v3';
  const base = e.breakdown
    ? {
        input_tokens: e.breakdown.input_tokens || 0,
        output_tokens: e.breakdown.output_tokens || 0,
        cache_read: e.breakdown.cache_read_input_tokens || 0,
        cache_creation: e.breakdown.cache_creation_input_tokens || 0,
        total: e.total_used || 0,
      }
    : {
        input_tokens: e.input_tokens || 0,
        output_tokens: e.output_tokens || 0,
        cache_read: e.cache_read || 0,
        cache_creation: e.cache_creation || 0,
        total: e.total || 0,
      };

  let cost;
  let unpriced = [];
  let tierUnknown = false;
  if (isV2 && e.by_model && Object.keys(e.by_model).length > 0) {
    cost = 0;
    for (const [modelId, u] of Object.entries(e.by_model)) {
      const r = costForModelUsage(modelId, u);
      cost += r.cost;
      if (!r.known) unpriced.push(modelId);
    }
  } else {
    // legacy shape (and v2 rows missing by_model): price breakdown totals at
    // the legacy default rate — no model is available to resolve per-model rates.
    // An aggregate row that does name a split-card model (haiku-5-5) is priced at
    // that model's <=100K card and flagged: per-request size is not visible here.
    const named = e.model ? priceForModel(e.model) : null;
    tierUnknown = !!(named && named.tierUnknown);
    const legacyRate = tierUnknown ? named : { input: 3, output: 15, cache_read: 0.30, cache_creation: 3.75 };
    cost =
      (base.input_tokens / 1_000_000) * legacyRate.input +
      (base.output_tokens / 1_000_000) * legacyRate.output +
      (base.cache_read / 1_000_000) * legacyRate.cache_read +
      (base.cache_creation / 1_000_000) * legacyRate.cache_creation;
  }

  return {
    sid: e.sid,
    ...base,
    ts: e.ts || null,
    cost,
    legacy: !isV2,
    unpriced,
    tierUnknown,
  };
}

// Reads optional session-map.jsonl {run_sid, claude_uuid, agent}.
// Returns Map<claude_uuid, agent> or null when file absent or empty.
function readSessionMap(stDir) {
  const p = path.join(stDir, 'session-map.jsonl');
  if (!fs.existsSync(p)) return null;
  const lines = fs.readFileSync(p, 'utf8').split('\n');
  const map = new Map();
  for (const line of lines) {
    if (!line.trim()) continue;
    try {
      const e = JSON.parse(line);
      if (e.claude_uuid && e.agent) map.set(e.claude_uuid, e.agent);
    } catch (_) {}
  }
  return map.size > 0 ? map : null;
}

// Advisor run-sids look like "<epoch>-<hex>" (e.g. "1783078917-04d530"),
// distinct from Claude Code session UUIDs stored in token-usage.jsonl.
function isRunSid(s) {
  return /^\d+-[0-9a-f]+$/.test(s);
}

// Resolves a run-sid to its claude_uuid via session-map.jsonl {run_sid, claude_uuid}.
// Returns null when session-map.jsonl is absent or has no matching entry.
function resolveRunSid(stDir, runSid) {
  const p = path.join(stDir, 'session-map.jsonl');
  if (!fs.existsSync(p)) return null;
  const lines = fs.readFileSync(p, 'utf8').split('\n');
  for (const line of lines) {
    if (!line.trim()) continue;
    try {
      const e = JSON.parse(line);
      if (e.run_sid === runSid && e.claude_uuid) return e.claude_uuid;
    } catch (_) {}
  }
  return null;
}

// Cache-aware cost. 5 params; modelId optional (falls back to sonnet rates).
function estimateCost(input_tokens, output_tokens, cache_read, cache_creation, modelId) {
  const r = priceForModel(modelId);
  return (
    (input_tokens   / 1_000_000) * r.input +
    (output_tokens  / 1_000_000) * r.output +
    (cache_read     / 1_000_000) * r.cache_read +
    (cache_creation / 1_000_000) * r.cache_creation
  );
}

// Returns {rows, noMap}.
// noMap=true means --by-agent was requested but session-map.jsonl absent — caller prints note.
function buildRows({ stateDirectory, sidFilter, lastN, byAgent } = {}) {
  const sd = stateDirectory || stateDir();

  const raw = readTokenUsage(sd);
  let sessions = lastPerSid(raw); // last-seen order, oldest→newest

  if (sidFilter) sessions = sessions.filter(e => e.sid === sidFilter);
  if (lastN) sessions = sessions.slice(-lastN); // most recent N by file position

  // reverse for display: newest first
  sessions = [...sessions].reverse();

  const rows = sessions.map(e => {
    const n = normalizeEntry(e);
    return {
      sid: n.sid,
      input: n.input_tokens,
      output: n.output_tokens,
      cache_read: n.cache_read,
      cache_creation: n.cache_creation,
      total: n.total,
      cost: n.cost,
      legacy: n.legacy,
      unpriced: n.unpriced,
      tierUnknown: n.tierUnknown,
    };
  });

  if (byAgent) {
    const sessionMap = readSessionMap(sd);
    if (!sessionMap) return { rows: [], noMap: true };

    const agents = new Map();
    for (const r of rows) {
      const agent = sessionMap.get(r.sid) || 'unknown';
      if (!agents.has(agent)) {
        agents.set(agent, { agent, input: 0, output: 0, cache_read: 0, cache_creation: 0, cost: 0, count: 0, legacyCount: 0, unpriced: [], tierUnknown: false });
      }
      const a = agents.get(agent);
      a.input       += r.input;
      a.output      += r.output;
      a.cache_read  += r.cache_read;
      a.cache_creation += r.cache_creation;
      a.cost        += r.cost;
      if (r.legacy) a.legacyCount++;
      if (r.tierUnknown) a.tierUnknown = true;
      for (const m of r.unpriced) if (!a.unpriced.includes(m)) a.unpriced.push(m);
      a.count++;
    }
    return { rows: [...agents.values()].sort((a, b) => b.cost - a.cost), noMap: false };
  }

  return { rows, noMap: false };
}

function fmt(n) { return Number(n).toLocaleString(); }
function fmtCost(c) { return '$' + Number(c).toFixed(4); }
function pad(s, n) { return String(s).slice(0, n).padEnd(n); }
// Numeric columns must never be truncated (unlike text columns) — slicing a
// formatted number mid-digit runs it into the next column with no separator.
// When the value overflows the column width, pad with a minimum gap instead
// of truncating, so it never runs directly into the next column.
function padNum(s, n) {
  const str = String(s);
  return str.length < n ? str.padEnd(n) : str + '  ';
}

// Trailing per-row annotation. Never appended to a TOTAL line — downstream
// consumers (lib/loop-driver.js parseCostFromOutput) take the last $amount on
// the TOTAL line as the cost, and this must stay the only $ token there.
function rowFlags(r) {
  const flags = [];
  if (r.legacy) flags.push('legacy(~2.14x over-counted, cost not adjusted)');
  for (const m of r.unpriced || []) flags.push(`unpriced:${m}`);
  if (r.tierUnknown) flags.push(HAIKU55_FLAG);
  return flags.length ? '  ' + flags.join(' ') : '';
}

function printTable({ rows, noMap }, byAgent) {
  if (noMap) {
    console.log('session-map not populated yet — per-agent cost unavailable; run more sessions after the worker-session-map hook ships.');
    return;
  }
  if (rows.length === 0) {
    console.log('No sessions found.');
    return;
  }

  if (byAgent) {
    console.log(pad('AGENT', 16) + pad('INPUT', 12) + pad('OUTPUT', 12) + pad('CACHE_READ', 12) + pad('CACHE_WR', 12) + pad('EST COST', 12) + 'SESSIONS');
    console.log('─'.repeat(88));
    for (const r of rows) {
      const flags = [];
      if (r.legacyCount) flags.push(`legacy(${r.legacyCount}, ~2.14x over-counted, cost not adjusted)`);
      for (const m of r.unpriced || []) flags.push(`unpriced:${m}`);
      if (r.tierUnknown) flags.push(HAIKU55_FLAG);
      console.log(pad(r.agent, 16) + padNum(fmt(r.input), 12) + padNum(fmt(r.output), 12) + padNum(fmt(r.cache_read), 12) + padNum(fmt(r.cache_creation), 12) + padNum(fmtCost(r.cost), 12) + r.count + (flags.length ? '  ' + flags.join(' ') : ''));
    }
    const totInput = rows.reduce((s, r) => s + r.input, 0);
    const totOutput = rows.reduce((s, r) => s + r.output, 0);
    const totRead = rows.reduce((s, r) => s + r.cache_read, 0);
    const totWr = rows.reduce((s, r) => s + r.cache_creation, 0);
    const totCost = rows.reduce((s, r) => s + r.cost, 0);
    const totCount = rows.reduce((s, r) => s + r.count, 0);
    console.log('─'.repeat(88));
    console.log(pad('TOTAL', 16) + padNum(fmt(totInput), 12) + padNum(fmt(totOutput), 12) + padNum(fmt(totRead), 12) + padNum(fmt(totWr), 12) + padNum(fmtCost(totCost), 12) + totCount);
  } else {
    console.log(pad('SID', 38) + pad('INPUT', 12) + pad('OUTPUT', 12) + pad('CACHE_READ', 12) + pad('CACHE_WR', 12) + 'EST COST');
    console.log('─'.repeat(92));
    for (const r of rows) {
      console.log(pad(r.sid, 38) + padNum(fmt(r.input), 12) + padNum(fmt(r.output), 12) + padNum(fmt(r.cache_read), 12) + padNum(fmt(r.cache_creation), 12) + fmtCost(r.cost) + rowFlags(r));
    }
    const totInput = rows.reduce((s, r) => s + r.input, 0);
    const totOutput = rows.reduce((s, r) => s + r.output, 0);
    const totRead = rows.reduce((s, r) => s + r.cache_read, 0);
    const totWr = rows.reduce((s, r) => s + r.cache_creation, 0);
    const totCost = rows.reduce((s, r) => s + r.cost, 0);
    console.log('─'.repeat(92));
    console.log(pad('TOTAL', 38) + padNum(fmt(totInput), 12) + padNum(fmt(totOutput), 12) + padNum(fmt(totRead), 12) + padNum(fmt(totWr), 12) + fmtCost(totCost));
  }
  console.log('\nPricing (per MTok, input/output/cache_read/cache_write_5m/cache_write_1h): haiku-5-5 0.10/0.50/0.01/0.125/0.20 (prompt<=100K; >100K 0.50/2.50/0.05/0.625/1.00)  haiku-4-5 1/5/0.10/1.25/2  sonnet-4-6 3/15/0.30/3.75/6  sonnet-5(.5) 2/10/0.20/2.5/4  opus-5(.5)/4-8/4-7/4-6 4-5/20-25/0.20-0.50/5-6.25/8-10  fable-5(.1) 10/50/0.25-1/12.5/20');
  console.log('cr=cache_read  cw=cache_creation(5m write)  default for unknown model: sonnet-5-5, flagged unpriced:<model>; haiku55-tier-unknown = aggregate row priced at the <=100K card, may under-count up to 5x');
  console.log('legacy = pre-dedupe-v2 row, no model; tokens over-counted ~2.14x median; cost NOT adjusted (priced at the legacy default rate)');
}

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') { out.help = true; continue; }
    if (a.startsWith('--')) {
      const k = a.slice(2);
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith('--')) { out[k] = next; i++; }
      else out[k] = true;
    } else {
      out._.push(a);
    }
  }
  return out;
}

// Resolves a user-supplied sid (positional arg or --sid flag) to the claude_uuid
// used as the key in token-usage.jsonl. Run-sids (e.g. "1783078917-04d530") are
// looked up in session-map.jsonl; anything else is assumed to already be a
// claude_uuid. Returns { sidFilter, error } — error is set when a run-sid has
// no session-map.jsonl entry.
function resolveSidArg(stDir, rawSid) {
  if (!rawSid) return { sidFilter: null, error: null };
  if (isRunSid(rawSid)) {
    const resolved = resolveRunSid(stDir, rawSid);
    if (!resolved) {
      return { sidFilter: null, error: `unknown or unmapped run-sid '${rawSid}' (no matching entry in session-map.jsonl)` };
    }
    return { sidFilter: resolved, error: null };
  }
  return { sidFilter: rawSid, error: null };
}

// Reverse of resolveRunSid: finds the run-sid mapped to a given claude_uuid.
// Last matching line wins (mirrors resolveRunSid's semantics).
function resolveRunSidForUuid(stDir, uuid) {
  const p = path.join(stDir, 'session-map.jsonl');
  if (!fs.existsSync(p)) return null;
  const lines = fs.readFileSync(p, 'utf8').split('\n');
  let found = null;
  for (const line of lines) {
    if (!line.trim()) continue;
    try {
      const e = JSON.parse(line);
      if (e.claude_uuid === uuid && e.run_sid) found = e.run_sid;
    } catch (_) {}
  }
  return found;
}

function printLiveRow(runSid, live, claudeUuid) {
  const b = live.breakdown;
  const cost = estimateCost(b.input_tokens, b.output_tokens, b.cache_read_input_tokens, b.cache_creation_input_tokens, null);
  console.log(pad('SID', 38) + pad('INPUT', 12) + pad('OUTPUT', 12) + pad('CACHE_READ', 12) + pad('CACHE_WR', 12) + 'EST COST');
  console.log('─'.repeat(92));
  console.log(pad(runSid, 38) + padNum(fmt(b.input_tokens), 12) + padNum(fmt(b.output_tokens), 12) + padNum(fmt(b.cache_read_input_tokens), 12) + padNum(fmt(b.cache_creation_input_tokens), 12) + fmtCost(cost));
  if (claudeUuid && claudeUuid !== runSid) {
    console.log(`(claude session: ${claudeUuid})`);
  }
  console.log(`\n(live, not yet accrued — run 'advisor-cost-backfill --sid ${runSid}' to persist)`);
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    process.stdout.write(`advisor-cost [--sid <uuid>] [--last N] [--by-agent]

Show estimated API cost per session from ~/.advisor/state/token-usage.jsonl.
All sessions are shown — no filtering (no meta.json join).

Options:
  --sid <uuid>  Show only this session UUID
  --last N      Show only the N most recent sessions (by file order)
  --by-agent    Aggregate by agent name (requires session-map.jsonl)

--by-agent reads ~/.advisor/state/session-map.jsonl with lines:
  {"run_sid":"<run-sid>","claude_uuid":"<uuid>","agent":"<name>"}
If the file is absent or empty, a note is printed and no table is shown.
The session-map writer (worker-session-map hook) must ship first.

Pricing (per million tokens; cache_write_5m / cache_write_1h are separate rates):
  Model                        input   output  cache_read  cache_write_5m  cache_write_1h
  claude-haiku-5-5             $0.10   $0.50   $0.01       $0.125          $0.20   (prompt <= 100K)
  claude-haiku-5-5:long        $0.50   $2.50   $0.05       $0.625          $1      (prompt > 100K; by_model key from telemetry)
  claude-haiku-4-5             $1      $5      $0.10       $1.25           $2
  claude-sonnet-4-6            $3      $15     $0.30       $3.75           $6
  claude-sonnet-5(.5)          $2      $10     $0.20       $2.50           $4
  claude-opus-5                $5      $25     $0.50       $6.25           $10
  claude-opus-5-5              $4      $20     $0.20       $5              $8
  claude-opus-4-8/4-7/4-6      $5      $25     $0.50       $6.25           $10
  claude-fable-5               $10     $50     $1          $12.50          $20
  claude-fable-5-1             $10     $50     $0.25       $12.50          $20
  default (unknown model)      $2      $10     $0.20       $2.50           $4   (sonnet-5; flagged unpriced:<model>)

v2 rows (token-usage.jsonl "counting":"dedupe-v2") carry per-model usage in
by_model and are priced exactly above. Legacy rows (no "counting" field) carry
no model, are over-counted ~2.14x median, and are priced at today's legacy
default (sonnet-4-6 @ 5m write rate) — marked "legacy" in the output.
Set ADVISOR_STATE_DIR to override ~/.advisor/state.
`);
    process.exit(0);
  }

  const sd = stateDir();
  const rawSid = args._[0] || args.sid || null;
  const { sidFilter, error } = resolveSidArg(sd, rawSid);
  if (error) {
    process.stderr.write(`advisor-cost: ${error}\n`);
    process.exit(1);
  }

  const result = buildRows({
    stateDirectory: sd,
    sidFilter,
    lastN: args.last ? parseInt(args.last, 10) : null,
    byAgent: !!args['by-agent'],
  });

  if (rawSid && !result.noMap && result.rows.length === 0) {
    const runSid = isRunSid(rawSid) ? rawSid : resolveRunSidForUuid(sd, sidFilter);
    const workspace = runSid ? telemetryBackfill.workspaceForRunSid(runSid) : null;
    if (runSid && workspace) {
      const live = telemetryBackfill.liveUsageForSid(runSid, workspace, sd);
      if (live.ok) {
        printLiveRow(runSid, live, sidFilter);
        return;
      }
      process.stderr.write(`advisor-cost: no telemetry found for '${rawSid}'\n`);
      process.exit(1);
    }
    process.stderr.write(`advisor-cost: no usage found for sid '${rawSid}'\n`);
    process.exit(1);
  }

  printTable(result, !!args['by-agent']);
}

module.exports = { buildRows, estimateCost, priceForModel, lastPerSid, normalizeEntry, readTokenUsage, readSessionMap, isRunSid, resolveRunSid, resolveSidArg, resolveRunSidForUuid };
if (require.main === module) main();
